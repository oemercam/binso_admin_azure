# Binso One – environment template
# Never commit real secrets. Use .env.local locally and Azure / GitHub environment settings in production.

# Public application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=https://www.binso.ch

# Supabase production backend
# Both values are required to enable real authentication, route protection and tenant persistence.
# They are public client configuration values; RLS remains the authorization boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Future server-side integrations. Leave unset until the corresponding production service is connected.
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
