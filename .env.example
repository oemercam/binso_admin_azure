# Server-only values: configure in Azure App Settings / secret storage.
APP_MODE=local
APP_URL=http://localhost:3000
# Optional emergency switch; false stops new passkey ceremonies, not existing sessions.
BINSO_PASSKEYS_ENABLED=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=https://www.binso.ch
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
APP_ENCRYPTION_KEY=
AUTH_ARTIFACT_RETENTION_DAYS=7
EXPIRED_SESSION_RETENTION_DAYS=30
# Stripe API version pinned in lib/server/stripe.ts: 2026-08-26.dahlia.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START_MONTHLY=
STRIPE_PRICE_START_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Enable only after Stripe Tax is configured for the business.
STRIPE_AUTOMATIC_TAX=false
STRIPE_PORTAL_RETURN_URL=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_USER_ID=
SUPPORT_EMAIL=support@binso.ch

# Optional local ClamAV INSTREAM socket. Missing = quarantine; errors = fail closed.
# Enable only after the scanner deployment/signature/limits checks in docs/security/file-scanning.md.
FILE_SCAN_SOCKET=

# Optional Web Push: configure all three server-side, never expose the private key.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
# Explicit opt-in for the persistent Node/App Service worker. Keep false in preview/QA.
# Requires DATABASE_URL, stable APP_ENCRYPTION_KEY and a matching VAPID key pair above.
WEB_PUSH_WORKER_ENABLED=false
# 30–900 seconds; invalid values fall back to 60. Azure App Service requires Always On.
WEB_PUSH_INTERVAL_SECONDS=60

