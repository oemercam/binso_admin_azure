# Server-only values: configure in Azure App Settings / secret storage.
APP_MODE=local
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=https://www.binso.ch
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
APP_ENCRYPTION_KEY=
# Stripe API version pinned in lib/server/stripe.ts: 2026-09-30.endive.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START_MONTHLY=
STRIPE_PRICE_START_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Enable only after Stripe Tax is configured for the business.
STRIPE_AUTOMATIC_TAX=false
STRIPE_PORTAL_RETURN_URL=
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=support@binso.ch
