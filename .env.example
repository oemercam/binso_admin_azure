# Authentication: local for development only, azure for deployed environments.
AUTH_MODE=local
# Fallback only when Azure does not provide an application role. Keep employee for least privilege; set owner for a single-owner deployment.
AUTH_DEFAULT_ROLE=employee
# Explicitly required if local auth is ever intentionally enabled in production.
ALLOW_LOCAL_AUTH=false
NEXT_PUBLIC_APP_NAME=Binso Admin
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_BUILD_ID=local
NEXT_PUBLIC_BUILD_DATE=
