# Binso One – environment template
# Never commit real secrets. Use .env.local locally and Azure App Settings / GitHub Environment secrets in production.

# Public application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=https://www.binso.ch

# Security
# Random server-only secret used to HMAC rate-limit identifiers before storage.
RATE_LIMIT_SECRET=

# Supabase customer backend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key.
# Used only by trusted server integration handlers such as signed Stripe webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PRO=

# Transactional email
RESEND_API_KEY=
# Example: Binso One <no-reply@binso.ch>
BINSO_EMAIL_FROM=

# Future provider integrations
# BANK_PROVIDER_API_KEY=
# BANK_PROVIDER_WEBHOOK_SECRET=
