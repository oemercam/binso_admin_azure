NEXT_PUBLIC_SITE_URL=https://www.binso.ch
# Runtime
NODE_ENV=development
APP_MODE=local
NEXT_PUBLIC_APP_MODE=local
APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=binso_session
OPERATOR_SESSION_COOKIE_NAME=binso_operator_session
OPERATOR_BOOTSTRAP_EMAIL=
OPERATOR_BOOTSTRAP_PASSWORD=
SESSION_TTL_HOURS=168

# PostgreSQL / Azure Database for PostgreSQL Flexible Server
DATABASE_URL=postgresql://user:password@host:5432/binso?sslmode=require
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START_MONTHLY=
STRIPE_PRICE_START_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Azure / observability
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=documents
AZURE_STORAGE_SAS=
APPLICATIONINSIGHTS_CONNECTION_STRING=
LOG_LEVEL=info

# Production security / email
APP_ENCRYPTION_KEY=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
RESEND_API_KEY=
EMAIL_FROM=Binso One <noreply@binso.ch>
SUPPORT_EMAIL=support@binso.ch
STRIPE_PORTAL_RETURN_URL=https://www.binso.ch/abo
