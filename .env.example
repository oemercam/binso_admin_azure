# Authentication: local for development only, azure for deployed environments.
AUTH_MODE=local
# Fallback only when Azure does not provide an application role. Keep employee for least privilege; set owner for a single-owner deployment.
AUTH_DEFAULT_ROLE=employee
# Explicitly required if local auth is ever intentionally enabled in production.
ALLOW_LOCAL_AUTH=false
NEXT_PUBLIC_APP_NAME=Binso One
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_BUILD_ID=local
NEXT_PUBLIC_BUILD_DATE=

# Azure Database for PostgreSQL / PostgreSQL persistence.
# Use the provider connection string. Keep credentials server-side only.
DATABASE_URL=
# Azure PostgreSQL requires TLS. Set false only for an explicitly trusted local development database.
DATABASE_SSL=true
# Maximum connections kept by the application process. Size this with Azure connection limits in mind.
DATABASE_POOL_MAX=10

# Authentication provider configured in Azure App Service Authentication.
AUTH_PROVIDER_NAME=aad
# Additional customer identity providers are intentionally not enabled yet.

# V59: production authentication uses Azure App Service Authentication / Microsoft Entra ID.
# DATABASE_URL may use sslmode=verify-full. db:migrate loads .env.local automatically.

# V63: Stripe Billing. Keep all secrets server-side.
# Use Stripe test-mode keys until production acceptance is complete.
APP_BASE_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# V67: encrypted browser push subscription storage. Generate a 32-byte key, Base64 encoded.
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=

# Invitations and document outbox via Microsoft Graph. Keep disabled for local development.
EMAIL_DELIVERY_MODE=disabled
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# User ID or UPN of the licensed/shared sender mailbox used by Graph sendMail.
GRAPH_SENDER_USER_ID=

# Internal scheduled operations. Use at least 32 random characters and configure the same value as
# GitHub Environment secret BINSO_ONE_INTERNAL_JOB_SECRET.
INTERNAL_JOB_SECRET=
