# Binso One environment template
# Copy to .env.local for local development. Never commit real secrets.

# Application
NODE_ENV=development
APP_MODE=local
NEXT_PUBLIC_APP_MODE=local
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LOG_LEVEL=info

# Session
SESSION_COOKIE_NAME=binso_session
OPERATOR_SESSION_COOKIE_NAME=binso_operator_session
SESSION_TTL_HOURS=168

# PostgreSQL
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# Encryption
APP_ENCRYPTION_KEY=

# Email / Resend
RESEND_API_KEY=
EMAIL_FROM=Binso One <noreply@binso.ch>
SUPPORT_EMAIL=support@binso.ch

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/einstellungen
STRIPE_PRICE_START_MONTHLY=
STRIPE_PRICE_START_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=documents
AZURE_STORAGE_SAS=

# Operator bootstrap - use only for the one-time bootstrap command
OPERATOR_BOOTSTRAP_EMAIL=
OPERATOR_BOOTSTRAP_PASSWORD=

# Optional build identifier; CI sets this to the Git commit SHA.
NEXT_PUBLIC_BUILD_COMMIT=local
