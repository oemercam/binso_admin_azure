{
  "name": "binso-one-local",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm test && pnpm release:check && pnpm lint && pnpm typecheck && pnpm build",
    "security:scan": "pnpm audit --audit-level high",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/check-db.mjs",
    "operator:bootstrap": "node scripts/bootstrap-operator.mjs",
    "permissions:test": "node scripts/permission-selfcheck.mjs",
    "test": "node scripts/permission-selfcheck.mjs && node scripts/production-selfcheck.mjs",
    "tenant:test": "node scripts/tenant-isolation-check.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "0.468.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "typescript": "5.9.3",
    "@types/pg": "8.15.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
