{
  "name": "binso-one",
  "version": "0.11.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "pnpm test && pnpm lint && pnpm typecheck && pnpm build",
    "security:scan": "pnpm audit --prod --audit-level high",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/check-db.mjs",
    "operator:bootstrap": "node scripts/bootstrap-operator.mjs",
    "permissions:test": "node scripts/permission-selfcheck.mjs",
    "test": "node scripts/architecture-selfcheck.mjs && node scripts/permission-selfcheck.mjs && node scripts/theme-selfcheck.mjs && node scripts/client-session-test.mjs && node scripts/migration-test.mjs && node scripts/data-lifecycle-schema-test.mjs && node scripts/ux-regression-test.mjs && node scripts/pwa-preview-test.mjs && node scripts/pwa-lifecycle-test.mjs && node scripts/document-presentation-test.mjs && node scripts/qa-plan-test.mjs && node scripts/browser-shards-test.mjs && node scripts/navigation-contract-test.mjs && node scripts/ui-foundation-test.mjs && node scripts/navigation-foundation-test.mjs && node scripts/data-foundation-test.mjs && node scripts/foundation-integration-test.mjs && node scripts/process-draft-test.mjs",
    "tenant:test": "node scripts/migration-test.mjs",
    "release:check": "node scripts/release-check.mjs",
    "ci": "pnpm release:check && pnpm test && pnpm lint && pnpm typecheck && pnpm build",
    "architecture:check": "node scripts/architecture-selfcheck.mjs",
    "architecture:hardcoding": "node scripts/architecture-selfcheck.mjs",
    "css:check": "node scripts/check-css-architecture.mjs",
    "routes:css-check": "node scripts/check-route-css.mjs",
    "retention:cleanup": "node scripts/retention-cleanup.mjs",
    "data:export": "node scripts/organization-data-lifecycle.mjs export",
    "data:delete": "node scripts/organization-data-lifecycle.mjs delete",
    "security:scan:all": "node scripts/full-security-audit.mjs",
    "repository:clean": "node scripts/repository-cleanliness-check.mjs",
    "docs:check": "node scripts/documentation-consistency-check.mjs",
    "qa:fast": "node scripts/qa.mjs fast",
    "qa:standard": "node scripts/qa.mjs standard",
    "qa:full": "node scripts/qa.mjs full",
    "qa:plan": "node scripts/qa-plan.mjs",
    "qa:plan:test": "node scripts/qa-plan-test.mjs",
    "ux:inventory": "node scripts/ux-inventory.mjs",
    "ux:lab": "node scripts/ux-lab-test.mjs",
    "qa:integration": "node scripts/qa.mjs integration",
    "qa:release": "node scripts/qa.mjs full",
    "test:loading": "node scripts/loading-browser-test.mjs",
    "ui:check": "node scripts/ui-foundation-test.mjs && node scripts/navigation-foundation-test.mjs",
    "data:inventory": "node scripts/data-inventory.mjs",
    "data:test": "node scripts/data-foundation-test.mjs",
    "architecture:inventory": "node scripts/foundation-integration-report.mjs"
  },
  "dependencies": {
    "@swc/helpers": "0.5.23",
    "lucide-react": "0.468.0",
    "next": "16.3.8",
    "pdfjs-dist": "5.4.296",
    "pdfkit": "0.17.2",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "swissqrbill": "4.4.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@types/node": "22.20.4",
    "@types/pdfkit": "0.17.3",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "overrides": {
      "source-map-js": "1.2.2"
    },
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "browserslist": {
    "production": [
      "Chrome >= 111",
      "Edge >= 111",
      "Firefox >= 111",
      "Safari >= 16.4",
      "iOS >= 16.4",
      "Samsung >= 23"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Edge version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ]
  }
}
