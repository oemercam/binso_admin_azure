{
  "name": "binso-admin-platform",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "architecture:check": "node scripts/check-architecture.mjs",
    "verify": "npm run typecheck && npm run lint && npm run architecture:check && npm run build",
    "build:turbo": "next build",
    "actions:check": "node scripts/check-actions.mjs",
    "process:check": "node scripts/check-process.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
